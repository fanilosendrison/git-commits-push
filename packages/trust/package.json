{
	"name": "@git-commits-push/trust",
	"version": "0.2.0",
	"description": "One-shot same-user guardrail permit shared by git-commits-push and its harness enforcer.",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"test": "pnpm run build && node --test --test-concurrency=1 test/*.test.ts",
		"typecheck": "pnpm run build && tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "22.20.0",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": "11.24.0"
	}
}
