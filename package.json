{
	"name": "git-commits-push-tl",
	"version": "0.2.0",
	"description": "Turnlock-orchestrated skill: discover dirty repos, LLM-generate commit messages, commit & push in parallel.",
	"type": "module",
	"private": true,
	"scripts": {
		"test": "bun run test:without-bridge && bun run test:bridge",
		"test:without-bridge": "bun test --timeout 60000 --ignore 'tests/unit/turnlock-to-llm-bridge.test.ts'",
		"test:bridge": "bun test --timeout 60000 tests/unit/turnlock-to-llm-bridge.test.ts",
		"test:quick": "bun test --timeout 60000 --ignore 'tests/unit/turnlock-to-llm-bridge.test.ts' --ignore 'tests/invariants/i1-secret-scanner.test.ts' --ignore 'tests/invariants/i3-parallel-isolation.test.ts' --ignore 'tests/invariants/i4-stdout-compliance.test.ts' && bun run test:bridge",
		"test:run": "PI_SKILL_STATS_MODE=test bun run src/entrypoints/turnlock-orchestrator.ts",
		"start": "bun run src/entrypoints/turnlock-orchestrator.ts | bun run src/entrypoints/turnlock-to-llm-bridge.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/ tests/"
	},
	"dependencies": {
		"@fanilosendrison/llm-runtime": "^0.1.2",
		"turnlock": "0.9.1",
		"ulid": "^2.4.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@types/bun": "1.3.14",
		"typescript": "^5.7.0"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
}
